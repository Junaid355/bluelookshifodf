        local Fill = Instance.new("Frame")
        local initPercent = math.clamp((default - min) / (max - min), 0, 1)
        Fill.Size = UDim2.new(initPercent, 0, 1, 0)
        Fill.BackgroundColor3 = Color3.fromRGB(0, 210, 255)
        Fill.BorderSizePixel = 0
        Fill.Parent = Track

