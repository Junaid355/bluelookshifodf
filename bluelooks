local lastShotTick = 0

local function CalculateBallisticVector(startPos, targetPos, speed)
    local diff = targetPos - startPos
    local flatDist = Vector3.new(diff.X, 0, diff.Z).Magnitude
    local v = math.max(speed or Config.ShotPower, 120)
    
    -- Gravity drop compensation for trajectory arc
    local g = Workspace.Gravity or 196.2
    local t = flatDist / v
    local gravityLift = math.clamp(0.42 * g * (t * t), 0, 7.5)
    
    local elevatedTarget = Vector3.new(targetPos.X, targetPos.Y + gravityLift, targetPos.Z)
    local dir = (elevatedTarget - startPos).Unit
    
    -- Clamped vertical pitch (-0.15 to +0.08) to drive straight into the net
    local clampedY = math.clamp(dir.Y, -0.15, 0.08)
    return Vector3.new(dir.X, clampedY, dir.Z).Unit
end

local function BoostBallRocket(targetPos, speed)
    if not Config.SuperRocketShot then return end
    lastShotTick = tick()
    task.spawn(function()
        local targetSpeed = math.clamp(speed or Config.ShotPower, 250, 650)
        local startTime = tick()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        
        -- Continuously accelerate ball toward goal, bypassing Bot GK hitboxes
        while (tick() - startTime) < 2.2 do
            pcall(function()
                local ball = GetBall()
                if ball and ball:IsA("BasePart") then
                    -- Prevent character from being pulled if ball is still welded
                    if char and ball:IsDescendantOf(char) then
                        return
                    end
                    
                    local distToGoal = math.abs(ball.Position.X - targetPos.X)
                    local isInsideNet = distToGoal <= 12
                    
                    -- Phase through GK dive hitbox during flight, re-enable touch only inside net for goal sensor
                    ball.CanCollide = false
                    if isInsideNet then
                        ball.CanTouch = true
                    else
                        ball.CanTouch = false
                    end
                    
                    -- Break any residual weld to character or other players
                    for _, j in ipairs(ball:GetChildren()) do
                        if j:IsA("JointInstance") or j:IsA("WeldConstraint") then
                            j:Destroy()
                        end
                    end
                    
                    local dir = (targetPos - ball.Position).Unit
                    
                    -- Dynamic lateral swerve to bypass bot dive trajectory
                    if Config.AutoCurve then
                        local curveOffset = math.sin((tick() - startTime) * 10) * 0.15
                        dir = Vector3.new(dir.X, dir.Y, dir.Z + curveOffset).Unit
                    end

                    -- Chaos Knuckleball (Erratic Multi-Frequency Aerodynamic Spin)
                    if Config.Knuckleball then
                        local elapsed = tick() - startTime
                        local kZ = math.sin(elapsed * 16) * (Config.KnuckleIntensity * 0.008)
                        local kY = math.cos(elapsed * 13) * (Config.KnuckleIntensity * 0.005)
                        dir = Vector3.new(dir.X, dir.Y + kY, dir.Z + kZ).Unit
                    end
                    
                    ball.AssemblyLinearVelocity = dir * targetSpeed
                    
                    local bv = ball:FindFirstChild("MetavisionRocketBV")
                    if not bv then
                        bv = Instance.new("BodyVelocity")
                        bv.Name = "MetavisionRocketBV"
                        bv.MaxForce = Vector3.new(1e7, 1e7, 1e7)
                        bv.Parent = ball
                    end
                    bv.Velocity = dir * targetSpeed
                end
            end)
            task.wait(0.015)
        end
        
        pcall(function()
            local ball = GetBall()
            if ball then
                ball.CanTouch = true
                if ball:FindFirstChild("MetavisionRocketBV") then
                    ball.MetavisionRocketBV:Destroy()
                end
            end
        end)
    end)
end

