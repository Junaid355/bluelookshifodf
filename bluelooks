local lastDashTick = 0
local function ExecuteDashBurst()
    local now = tick()
    if (now - lastDashTick) < 0.28 then return end
    lastDashTick = now

    pcall(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChild("Humanoid")
        if hrp and hum then
            local moveDir = hum.MoveDirection
            if moveDir.Magnitude == 0 then moveDir = hrp.CFrame.LookVector end
            
            -- Physical Dash Boost with BodyVelocity
            if hrp:FindFirstChild("LunarDashBV") then hrp.LunarDashBV:Destroy() end
            
            local bv = Instance.new("BodyVelocity")
            bv.Name = "LunarDashBV"
            bv.MaxForce = Vector3.new(1e6, 0, 1e6)
            bv.Velocity = moveDir.Unit * 95
            bv.Parent = hrp
            
            task.delay(0.24, function()
                if bv and bv.Parent then bv:Destroy() end
            end)
            
            if Events and Events:FindFirstChild("SlideBegan") then Events.SlideBegan:FireServer() end
            PlaySound("rbxassetid://6895079853", 1.25)
        end
    end)
end

local function GetBestTeammatePassTarget()
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil end
    
    local enemyGoal = GetEnemyGoal()
    local bestTeammate = nil
    local bestScore = -9999
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and (plr.Team == LocalPlayer.Team or (not plr.Team and not LocalPlayer.Team)) and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local tHrp = plr.Character.HumanoidRootPart
            local distToMe = (tHrp.Position - myHrp.Position).Magnitude
            if distToMe >= 10 and distToMe <= 140 then
                local distToGoal = (tHrp.Position - enemyGoal).Magnitude
                local forwardScore = 250 - distToGoal
                
                -- Check if teammate is marked by an enemy
                local isMarked = false
                for _, enemy in ipairs(Players:GetPlayers()) do
                    if enemy ~= plr and enemy.Team ~= plr.Team and enemy.Character and enemy.Character:FindFirstChild("HumanoidRootPart") then
                        if (enemy.Character.HumanoidRootPart.Position - tHrp.Position).Magnitude < 12 then
                            isMarked = true
                            break
                        end
                    end
                end
                
                local score = forwardScore - (isMarked and 70 or 0) - (distToMe * 0.25)
                if score > bestScore then
                    bestScore = score
                    bestTeammate = plr.Character
                end
            end
        end
    end
    
    return bestTeammate
end

local function ExecuteAutoPass()
    pcall(function()
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local ball = GetBall()
        if not hrp or not ball then return end
        
        local distToBall = (ball.Position - hrp.Position).Magnitude
        local hasBall = char:GetAttribute("HasBall") == true or distToBall <= 7.5
        if not hasBall then
            Notify("Notice", "You need possession of the ball to pass!", 1.2, "⚠️")
            return
        end
        
        local targetTeammate = GetBestTeammatePassTarget()
        if targetTeammate and targetTeammate:FindFirstChild("HumanoidRootPart") then
            local tHrp = targetTeammate.HumanoidRootPart
            local hum = targetTeammate:FindFirstChild("Humanoid")
            local leadPos = tHrp.Position + (hum and (hum.MoveDirection * 4.5) or Vector3.zero) + Vector3.new(0, 0.4, 0)
            local passDir = (leadPos - hrp.Position).Unit
            
            lastShotTick = tick()
            if Events and Events:FindFirstChild("ShootBall") then
                Events.ShootBall:FireServer(passDir, 75)
            end
            
            -- Smooth, unblockable pass velocity to teammate boots
            task.spawn(function()
                local startTime = tick()
                while (tick() - startTime) < 1.4 do
                    pcall(function()
                        local b = GetBall()
                        if b and b:IsA("BasePart") then
                            b.CanCollide = false
                            local d = (leadPos - b.Position).Unit
                            b.AssemblyLinearVelocity = d * 95
                        end
                    end)
                    task.wait(0.015)
                end
            end)
            
            Notify("🎯 Smart Pass", "Pass delivered to " .. targetTeammate.Name .. "!", 1.5, "🎯")
        else
            Notify("Notice", "No open teammates in passing range!", 1.2, "⚠️")
        end
    end)
end

-- Dynamic Viewport Sizing for Mobile & PC
local function GetResponsiveFrameSize()
    local vp = Camera.ViewportSize
    local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    if isMobile or vp.X < 900 or vp.Y < 600 then
        local w = math.clamp(vp.X * 0.88, 460, 680)
        local h = math.clamp(vp.Y * 0.84, 280, 440)
        return UDim2.new(0, w, 0, h), UDim2.new(0.5, -w/2, 0.5, -h/2)
    else
        return UDim2.new(0, 760, 0, 490), UDim2.new(0.5, -380, 0.5, -245)
    end
end

